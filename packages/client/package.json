{
  "name": "@prompt-dev/client",
  "version": "1.0.0",
  "description": "Client code for access that chat/assistant data layer.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@prompt-dev/prettier-config": "workspace:*",
    "@prompt-dev/typescript-config": "workspace:*",
    "@tanstack/react-query": "^5.90.21",
    "react": "19.1.0",
    "@types/react": "^19.1.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.99",
    "@prompt-dev/shared-types": "workspace:*",
    "ai": "^6.0.97",
    "date-fns": "^4.1.0",
    "fp-ts": "^2.16.11",
    "jotai": "^2.18.0",
    "zod": "4.3.6"
  }
}
