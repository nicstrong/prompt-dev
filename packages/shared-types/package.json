{
  "name": "@prompt-dev/shared-types",
  "version": "1.0.0",
  "description": "Shared types between the API and web app.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@prompt-dev/prettier-config": "workspace:*",
    "@prompt-dev/typescript-config": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "prettier": "^3.6.2",
    "zod": "3.25.76"
  }
}
